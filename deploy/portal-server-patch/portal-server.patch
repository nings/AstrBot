+++ w/astrbot/portal/services/sso/base.py
@@ -0,0 +1,291 @@
+"""The SSO provider abstraction: one interface, two genuinely different trust bases.
+
+This module exists to answer exactly one design question honestly: generic
+OIDC and WeCom/Feishu do **not** produce identity the same way, and the
+abstraction must never let that difference get papered over.
+
+* **OIDC** (:mod:`astrbot.portal.services.sso.oidc`) hands back an
+  ``id_token`` -- a cryptographically **signed assertion** -- whose
+  signature, issuer, audience, expiry and nonce are verified against the
+  provider's own published JWKS. The trust anchor is a public key the portal
+  never has to keep secret.
+* **WeCom/Feishu** (adapters not owned by this file set -- see
+  ``notes_for_integrator``) have no signed assertion at all: a callback code
+  is exchanged, using this app's own confidential ``app_secret``, for an
+  **API response** that *claims* to describe a user. The trust anchor there
+  is the confidentiality of a shared secret plus the response genuinely
+  being for this app's registration -- nothing cryptographically verifiable
+  about the payload itself.
+
+Those are not two flavors of the same guarantee; they are different
+guarantees. So :class:`VerifiedIdentity` -- the one shape every adapter hands
+back to :mod:`astrbot.portal.services.sso_service` -- carries its
+``trust_basis`` as a mandatory field on every single instance, not as
+incidental metadata the caller has to already know out-of-band. Any code
+downstream that wants to treat "this identity's email is provably owned by
+the presenter" as true MUST check ``trust_basis == SsoTrustBasis.SIGNED_ASSERTION``
+first -- an :class:`AUTHENTICATED_API_RESPONSE` identity can never earn that
+trust level no matter what its ``email_verified`` field says, because there
+is no signature backing that claim at all, only "the app secret has not
+leaked (that we know of)".
+
+``sso_service.py`` additionally cross-checks a returned identity's
+``trust_basis`` against the *adapter instance's own* statically-declared
+``trust_basis`` class attribute before accepting it -- see that module's
+``security_decisions`` -- specifically so a buggy or malicious adapter
+cannot unilaterally claim ``SIGNED_ASSERTION`` for an identity it never
+cryptographically verified. This file only defines the shape; that
+enforcement lives at the call site since this module intentionally has no
+knowledge of which concrete adapters exist.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any, Protocol, runtime_checkable
+
+# ---------------------------------------------------------------------------
+# Trust basis: the load-bearing distinction this whole module exists for.
+# ---------------------------------------------------------------------------
+
+
+class SsoTrustBasis(str, Enum):
+    """What was actually verified about a :class:`VerifiedIdentity`, and how."""
+
+    SIGNED_ASSERTION = "signed_assertion"
+    """The identity came from a cryptographically signed token (an OIDC
+    ``id_token``) whose signature was verified against the issuer's published
+    JWKS, together with issuer/audience/expiry/nonce checks. An email on an
+    identity at this trust level MAY be trusted as provider-attested,
+    provided the token's own ``email_verified`` claim was also checked
+    (a signature only proves the IdP said this; it does not by itself prove
+    the IdP verified the email address)."""
+
+    AUTHENTICATED_API_RESPONSE = "authenticated_api_response"
+    """The identity came from an authenticated API call (this app's
+    ``app_secret`` was used to obtain/present a token, then a userinfo-style
+    endpoint was called), with no cryptographically signed assertion
+    involved anywhere in the chain. Trust rests entirely on the
+    confidentiality of the app secret and on the HTTP response genuinely
+    coming from the real provider over TLS -- there is no signature to
+    verify and no JWKS to check it against. An identity at this trust level
+    must never be treated as equivalent to :attr:`SIGNED_ASSERTION` for any
+    security decision (e.g. email-based account linking) even if it reports
+    an ``email_verified``-shaped field, because nothing here is a *signed*
+    claim a relying party could verify independently of trusting the
+    provider's live API right now."""
+
+
+# ---------------------------------------------------------------------------
+# Provider-adapter error hierarchy. Kept intentionally separate from
+# sso_service.py's own SsoServiceError hierarchy (policy-layer errors) --
+# these are protocol/adapter-layer failures (discovery, token exchange,
+# signature/claim verification, or a non-OIDC provider's API call failing),
+# raised by whatever concrete class implements SsoProvider below.
+# ---------------------------------------------------------------------------
+
+
+class SsoProviderError(Exception):
+    """Base class for every failure an :class:`SsoProvider` adapter raises.
+
+    ``sso_service.py`` catches this at the call site rather than letting an
+    adapter's underlying SDK/library exception (``httpx.HTTPError``,
+    ``jwt.PyJWTError``, a raw ``wechatpy``/``lark_oapi`` exception, ...)
+    escape past the service boundary -- callers of ``sso_service`` should
+    never need to know or care which HTTP/JWT/enterprise-SDK library a given
+    provider adapter happens to use internally.
+    """
+
+
+class SsoDiscoveryError(SsoProviderError):
+    """An OIDC discovery document could not be fetched, was not valid JSON,
+    was missing a required field, or its ``issuer`` did not match the
+    configured issuer. Not applicable to non-OIDC providers, which have no
+    discovery step."""
+
+
+class SsoIdentityVerificationError(SsoProviderError):
+    """The provider's response could not be trusted as presented: for OIDC,
+    a bad signature, disallowed algorithm, wrong ``iss``/``aud``, expired/
+    not-yet-valid token, or a ``nonce`` that does not match the one this
+    flow issued; for an API-response provider, a token-exchange or userinfo
+    call that failed, returned an unexpected shape, or could not be
+    attributed to this app's own registration."""
+
+
+class SsoTemporaryError(SsoProviderError):
+    """A network/timeout failure talking to the provider (discovery, token
+    exchange, JWKS fetch, userinfo call). Distinguished from
+    :class:`SsoIdentityVerificationError` because this class of failure is
+    plausibly transient/retryable, whereas a verification failure never
+    becomes valid no matter how many times it is retried."""
+
+
+# ---------------------------------------------------------------------------
+# Data shapes exchanged between sso_service.py and every SsoProvider adapter.
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class AuthorizationRequest:
+    """What an adapter hands back from starting a new flow.
+
+    ``state`` is the opaque CSRF-protection value the provider is expected
+    to echo back verbatim on its callback -- ``sso_service.py`` uses it as
+    the lookup key for the pending-flow record it stores server-side, and
+    additionally binds it to the initiating browser via a cookie (see that
+    module's docstring). It must be unique per flow and unguessable
+    (adapters should generate it with ``secrets.token_urlsafe`` or
+    equivalent, never a predictable value).
+
+    ``provider_state`` carries whatever *additional* per-flow secret
+    material this specific adapter needs re-presented to
+    :meth:`SsoProvider.resolve_identity` at callback time, keyed by name --
+    for OIDC this is ``{"nonce": ..., "code_verifier": ...}``; a provider
+    with no such additional state (there is currently no such provider in
+    scope, but the shape allows for one) may return an empty mapping.
+    ``sso_service.py`` treats the contents as opaque strings it merely
+    stores and replays back to the same adapter instance -- it never
+    inspects or interprets them itself, which is what keeps this seam
+    generic across trust bases.
+    """
+
+    authorize_url: str
+    state: str
+    provider_state: Mapping[str, str] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class VerifiedIdentity:
+    """The one shape every :class:`SsoProvider` adapter resolves a callback into.
+
+    ``subject`` is always the provider's own stable, non-reassignable
+    identifier for this account (OIDC's ``sub`` claim; WeCom/Feishu's own
+    internal user id) -- **never** an email address. Emails can change and
+    be reassigned by an IdP administrator; matching or storing identity by
+    email would silently break (or worse, redirect) the binding the moment
+    that happens. ``PortalOAuthIdentity.provider_subject`` stores exactly
+    this value.
+
+    ``trust_basis`` is mandatory on every instance (not just documented on
+    the producing class) precisely so a consumer of this dataclass can never
+    accidentally treat an unverified API-response identity as cryptographically
+    attested just because it happened to flow through the same code path as
+    an OIDC one -- see this module's docstring.
+
+    ``email_verified`` must be ``False`` whenever the upstream provider
+    omitted the concept entirely (no ``email_verified``-shaped field in its
+    response at all) -- absence is never treated as "verified by omission".
+    Adapters must set this explicitly rather than leaving it at the
+    dataclass default and hoping the default is safe; the default below
+    (``False``) exists only as a fail-closed guard against an adapter bug
+    that forgets to set the field, not as a license to skip setting it.
+    """
+
+    provider: str
+    subject: str
+    trust_basis: SsoTrustBasis
+    email: str | None = None
+    email_verified: bool = False
+    display_name: str | None = None
+    raw: Mapping[str, Any] = field(default_factory=dict)
+    """Adapter-specific decoded claims/profile payload, kept only for audit/
+    debugging -- never re-derive an authorization decision from this field
+    downstream; every value that matters for a decision must already be one
+    of the named fields above."""
+
+    def __post_init__(self) -> None:
+        if not self.subject:
+            raise ValueError("VerifiedIdentity.subject must not be empty")
+        if not self.provider:
+            raise ValueError("VerifiedIdentity.provider must not be empty")
+
+
+# ---------------------------------------------------------------------------
+# The provider protocol itself.
+# ---------------------------------------------------------------------------
+
+
+@runtime_checkable
+class SsoProvider(Protocol):
+    """What ``sso_service.py`` needs from any identity provider adapter.
+
+    Deliberately two async methods and nothing else -- no shared "verify"
+    step that could be tricked into skipping OIDC's cryptographic checks by
+    a provider that simply declares itself non-OIDC. Each concrete adapter
+    performs its *entire* trust chain (whatever that looks like for its own
+    protocol) inside :meth:`resolve_identity` and returns only the fully
+    resolved, already-verified-per-its-own-rules :class:`VerifiedIdentity` --
+    there is no intermediate "partially verified" shape for ``sso_service.py``
+    to misuse.
+
+    ``provider_id`` must be one of ``astrbot.portal.config.ALL_SSO_PROVIDERS``.
+    ``trust_basis`` is a fixed class-level property of the adapter (an OIDC
+    adapter is always :attr:`SsoTrustBasis.SIGNED_ASSERTION`; a WeCom/Feishu
+    adapter is always :attr:`SsoTrustBasis.AUTHENTICATED_API_RESPONSE`) --
+    it does not vary per call, which is exactly what lets ``sso_service.py``
+    cross-check it against whatever a given ``resolve_identity`` call
+    returns (see module docstring).
+    """
+
+    provider_id: str
+    trust_basis: SsoTrustBasis
+
+    async def build_authorization_request(
+        self, *, redirect_uri: str
+    ) -> AuthorizationRequest:
+        """Start a new flow: return the URL to redirect the browser to plus
+        whatever per-flow secret state (``state``, and any
+        ``provider_state`` such as OIDC's ``nonce``/PKCE ``code_verifier``)
+        must be persisted server-side until the callback arrives.
+
+        Must not perform the redirect itself, must not raise for anything
+        other than a genuine failure to construct the request (e.g. OIDC
+        discovery failing) -- raises :class:`SsoProviderError` subclasses on
+        failure.
+        """
+        ...
+
+    async def resolve_identity(
+        self,
+        *,
+        code: str,
+        redirect_uri: str,
+        provider_state: Mapping[str, str],
+    ) -> VerifiedIdentity:
+        """Complete a flow: exchange ``code`` for identity and return a
+        fully verified :class:`VerifiedIdentity`, or raise.
+
+        ``redirect_uri`` must be byte-for-byte the same value passed to
+        :meth:`build_authorization_request` for this same flow (some
+        providers re-check it during token exchange; all of them are
+        entitled to). ``provider_state`` is exactly what this same adapter
+        returned from :meth:`build_authorization_request` at flow start,
+        replayed back verbatim by ``sso_service.py`` from its pending-flow
+        store -- the caller (``sso_service.py``) has already validated
+        ``state``/CSRF-binding by the time this is called; this method only
+        ever receives a request for a flow whose ``state`` was already
+        confirmed to belong to the presenting browser.
+
+        Raises:
+            SsoDiscoveryError: (OIDC only) discovery document invalid.
+            SsoIdentityVerificationError: signature/claims/nonce failed, or
+                (non-OIDC) the provider's API call failed/returned garbage.
+            SsoTemporaryError: a network/timeout failure -- plausibly worth
+                a retry at the caller's discretion.
+        """
+        ...
+
+
+__all__ = [
+    "SsoTrustBasis",
+    "SsoProviderError",
+    "SsoDiscoveryError",
+    "SsoIdentityVerificationError",
+    "SsoTemporaryError",
+    "AuthorizationRequest",
+    "VerifiedIdentity",
+    "SsoProvider",
+]
diff --git c/astrbot/portal/services/sso/feishu.py w/astrbot/portal/services/sso/feishu.py
new file mode 100644
index 00000000..45328a79
--- /dev/null
+++ w/astrbot/portal/services/sso/feishu.py
@@ -0,0 +1,303 @@
+"""Feishu (飞书) SSO adapter.
+
+Trust basis: :attr:`~astrbot.portal.services.sso.base.SsoTrustBasis.AUTHENTICATED_API_RESPONSE`
+-- **not** ``SIGNED_ASSERTION``, for the same structural reason as
+:mod:`astrbot.portal.services.sso.wecom` (see that module's docstring for the
+long version). Concretely for Feishu: the browser is sent to
+``open-apis/authen/v1/authorize`` and comes back with a bare ``code``; this
+adapter exchanges that code for a **user access token** via
+``open-apis/authen/v1/oidc/access_token`` (an app-authenticated API call, using
+this app's own ``app_id``/``app_secret``), then calls
+``open-apis/authen/v1/user_info`` with that user access token to get a profile.
+Despite the endpoint name containing "oidc", **no ``id_token`` is ever returned
+anywhere in this flow** -- there is no JWT, no signature, nothing this portal
+verifies cryptographically. Every step of trust here rests on ``feishu_app_secret``
+staying confidential and on ``open.feishu.cn`` genuinely being Feishu's API server
+(TLS) -- exactly the ``AUTHENTICATED_API_RESPONSE`` shape, never
+``SIGNED_ASSERTION``. ``sso_service.py`` structurally enforces this distinction
+(see ``astrbot.portal.services.sso.base``'s module docstring) rather than
+trusting this docstring alone.
+
+Stable subject: Feishu's ``union_id``, falling back to ``open_id`` only if
+``union_id`` is absent from an otherwise-successful response (never Feishu's
+``user_id`` or any email field). Feishu documents three different identifiers
+for the "same" underlying person, at three different scopes:
+
+* ``open_id`` -- unique per user *per app*. Always present in the base
+  ``user_info`` response with no extra permission grant required.
+* ``union_id`` -- unique per user *across every app registered under the same
+  developer/ISV account*. Also always present in the base response with no
+  extra permission grant required. This is Feishu's own purpose-built answer to
+  "identify the same person consistently," which is exactly the property a
+  stable SSO subject needs.
+* ``user_id`` -- unique per user *within one tenant's contacts*, but only
+  populated if the app has been separately granted a tenant-contacts read
+  permission in the Feishu admin console. A login-only app registration may
+  well not have that permission, in which case this field is silently empty --
+  making it an unreliable primary choice for a generic adapter that cannot
+  assume any particular permission grant.
+
+``union_id`` is picked over ``open_id`` as the primary choice because it is the
+identifier Feishu itself designed for cross-app person-identification, and it
+costs nothing here (no extra permission needed, always present alongside
+``open_id`` in the same response) -- but since this portal deployment only ever
+registers one ``feishu_app_id``, ``open_id`` would be equally stable in
+practice, hence it is kept as a fallback rather than treated as invalid. Neither
+is ever an email address, and neither can be reassigned to a different person
+by an administrator the way an email or username can.
+
+Credential separation (rule 6): ``feishu_app_id``/``feishu_app_secret``
+(``astrbot.portal.config.PortalSettings``) are a **separate** app registration
+used only for this web-login flow. This module never reads, imports, or
+otherwise touches ``astrbot/core/platform/sources/lark/``, which holds the
+operator's IM-bot credentials for an entirely different purpose (receiving chat
+messages). A compromise of one must never be a compromise of the other.
+
+Why this adapter calls ``lark_oapi``'s **synchronous** ``.create()``/``.get()``
+methods via ``asyncio.to_thread`` rather than its nominally-async
+``.acreate()``/``.aget()`` counterparts: ``lark_oapi`` 1.4.x's async request path
+(``Client.arequest`` / the generated ``acreate``/``aget`` wrappers) still calls
+``lark_oapi.core.token.verify()`` synchronously before ever awaiting anything,
+and ``verify()`` -- when the app access token is not already cached -- fetches
+it via ``TokenManager.get_self_app_token()``, which unconditionally calls
+``Transport.execute`` (the **blocking**, ``requests``-based transport), never
+``Transport.aexecute`` (the ``httpx``-based one), regardless of which of the two
+public methods triggered it. So the "async" methods are only genuinely async
+for the *second* network call in any flow where the app token needs a fresh
+fetch, and can silently block the event loop for the first one -- exactly the
+kind of stall this phase's "hard timeout on every outbound call" requirement is
+meant to prevent from taking down other in-flight requests on the same worker,
+even though the timeout itself (``conf.timeout``, threaded through to both
+``Transport.execute`` and ``Transport.aexecute`` identically) is honoured either
+way. Routing every call -- both the token exchange and the user-info fetch --
+through the synchronous methods via ``asyncio.to_thread`` uniformly sidesteps
+this asymmetry entirely (mirrors the exact pattern
+:mod:`astrbot.portal.services.sso.oidc` already uses for ``jwt.PyJWKClient``'s
+own blocking JWKS fetch). See this phase's handoff report for the full
+writeup.
+
+Also note: ``lark_oapi.api.authen.v1.resource.authorize.Authorize.get()`` (the
+SDK's generated binding for ``GET /open-apis/authen/v1/authorize``) is
+deliberately **not called** anywhere in this file. That endpoint is a
+browser-redirect-only page (the user's browser is sent there directly; Feishu
+renders a login/consent page and redirects back to ``redirect_uri`` with a
+``code`` once the user approves) -- it was never meant to be invoked as a
+server-to-server JSON API call the way the rest of ``lark_oapi``'s generated
+surface is, and calling it that way would just fetch Feishu's HTML login page
+and fail to parse as the ``GetAuthorizeResponse`` shape the binding expects.
+This adapter instead builds that URL directly (see
+:meth:`build_authorization_request`), exactly as Feishu's own integration guide
+documents doing by hand.
+
+Flow implemented, end to end:
+
+1. :meth:`build_authorization_request` -- builds the
+   ``open-apis/authen/v1/authorize`` browser-redirect URL with a fresh,
+   unguessable ``state``. No PKCE/nonce concept applies here (there is no
+   signed assertion to bind one to); ``state`` is still generated and checked
+   by ``sso_service.py`` like every other provider, since this flow remains
+   CSRF-prone without it.
+2. :meth:`resolve_identity` -- exchanges the callback ``code`` for a user
+   access token via ``authen/v1/oidc/access_token`` (app-authenticated; the SDK
+   auto-fetches/caches the app access token from ``feishu_app_id``/
+   ``feishu_app_secret``), then calls ``authen/v1/user_info`` with that user
+   access token to resolve profile fields, and returns the
+   :class:`~astrbot.portal.services.sso.base.VerifiedIdentity` with
+   ``email_verified`` always ``False`` (Feishu's ``email``/``enterprise_email``
+   fields are directory attributes, not something the presenter proved
+   ownership of via any verification step -- see this module's trust-basis
+   section above).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import secrets
+from collections.abc import Mapping
+from urllib.parse import urlencode
+
+import lark_oapi as lark
+import requests
+from lark_oapi.api.authen.v1 import (
+    CreateOidcAccessTokenRequest,
+    CreateOidcAccessTokenRequestBody,
+    GetUserInfoRequest,
+    GetUserInfoResponseBody,
+)
+from lark_oapi.core.exception import (
+    NoAuthorizationException,
+    ObtainAccessTokenException,
+)
+from lark_oapi.core.model import RequestOption
+
+from astrbot.core import logger
+from astrbot.portal.config import SSO_PROVIDER_FEISHU
+from astrbot.portal.services.sso.base import (
+    AuthorizationRequest,
+    SsoIdentityVerificationError,
+    SsoTemporaryError,
+    SsoTrustBasis,
+    VerifiedIdentity,
+)
+
+_HTTP_TIMEOUT_SECONDS = 10.0
+"""Hard timeout threaded through to ``lark_oapi``'s ``Config.timeout``, applied
+by its own ``Transport`` to every outbound call this adapter triggers
+(app-token fetch, the oidc code exchange, the user_info call)."""
+
+_AUTHORIZE_URL = "https://open.feishu.cn/open-apis/authen/v1/authorize"
+"""Browser-redirect-only login page -- see module docstring for why this is
+built by hand rather than via ``lark_oapi``'s generated ``Authorize.get()``
+binding."""
+
+
+class FeishuProvider:
+    """Feishu (飞书) SSO adapter. See module docstring for the trust basis and
+    the ``lark_oapi`` sync-vs-async call-path rationale."""
+
+    provider_id = SSO_PROVIDER_FEISHU
+    trust_basis = SsoTrustBasis.AUTHENTICATED_API_RESPONSE
+
+    def __init__(
+        self,
+        *,
+        app_id: str,
+        app_secret: str,
+        http_timeout_seconds: float = _HTTP_TIMEOUT_SECONDS,
+    ) -> None:
+        if not app_id or not app_secret:
+            raise ValueError("FeishuProvider requires both app_id and app_secret")
+
+        self._app_id = app_id
+        # enable_set_token=True is required so this adapter can hand the SDK a
+        # *user* access token it obtained itself (for the user_info call)
+        # rather than only ever letting the SDK manage tenant/app tokens on its
+        # own -- see lark_oapi.core.token.verify()'s branching, and this
+        # module's docstring. The app-token path (used for the oidc code
+        # exchange) is unaffected by this flag: verify() still auto-fetches it
+        # from app_id/app_secret whenever the caller does not supply one via
+        # RequestOption, which this adapter never does for that call.
+        self._client = (
+            lark.Client.builder()
+            .app_id(app_id)
+            .app_secret(app_secret)
+            .timeout(http_timeout_seconds)
+            .enable_set_token(True)
+            .build()
+        )
+
+    # -- SsoProvider protocol --------------------------------------------
+
+    async def build_authorization_request(
+        self, *, redirect_uri: str
+    ) -> AuthorizationRequest:
+        state = secrets.token_urlsafe(32)
+        params = {
+            "app_id": self._app_id,
+            "redirect_uri": redirect_uri,
+            "state": state,
+        }
+        authorize_url = f"{_AUTHORIZE_URL}?{urlencode(params)}"
+        return AuthorizationRequest(
+            authorize_url=authorize_url, state=state, provider_state={}
+        )
+
+    async def resolve_identity(
+        self,
+        *,
+        code: str,
+        redirect_uri: str,
+        provider_state: Mapping[str, str],
+    ) -> VerifiedIdentity:
+        if not code:
+            raise SsoIdentityVerificationError(
+                "Feishu callback did not include an authorization code"
+            )
+
+        user_access_token = await self._exchange_code(code)
+        profile = await self._get_user_info(user_access_token)
+
+        subject = profile.union_id or profile.open_id
+        if not subject:
+            raise SsoIdentityVerificationError(
+                "Feishu user_info response contained neither union_id nor open_id"
+            )
+
+        display_name = profile.name or profile.en_name
+        display_name = display_name if isinstance(display_name, str) and display_name else None
+
+        email = profile.email or profile.enterprise_email
+        email = email if isinstance(email, str) and email else None
+
+        return VerifiedIdentity(
+            provider=self.provider_id,
+            subject=subject,
+            trust_basis=self.trust_basis,
+            email=email,
+            # Feishu's email/enterprise_email are tenant-directory attributes,
+            # never something the presenter proved ownership of via a
+            # verification step -- always False, per this module's trust-basis
+            # section and the base module's contract.
+            email_verified=False,
+            display_name=display_name,
+            raw={"open_id": profile.open_id, "union_id": profile.union_id},
+        )
+
+    # -- internals ---------------------------------------------------------
+
+    async def _exchange_code(self, code: str) -> str:
+        request = (
+            CreateOidcAccessTokenRequest.builder()
+            .request_body(
+                CreateOidcAccessTokenRequestBody.builder()
+                .grant_type("authorization_code")
+                .code(code)
+                .build()
+            )
+            .build()
+        )
+        try:
+            # See module docstring: the sync method, off-thread, uniformly --
+            # not `.acreate()`.
+            response = await asyncio.to_thread(
+                self._client.authen.v1.oidc_access_token.create, request
+            )
+        except (NoAuthorizationException, ObtainAccessTokenException) as exc:
+            raise SsoIdentityVerificationError(
+                f"Feishu app-credential check failed during token exchange: {exc}"
+            ) from exc
+        except requests.exceptions.RequestException as exc:
+            raise SsoTemporaryError(
+                f"Feishu token exchange request failed: {exc}"
+            ) from exc
+
+        if not response.success() or response.data is None or not response.data.access_token:
+            logger.warning(
+                f"[portal][sso][feishu] oidc token exchange rejected: code={response.code}"
+            )
+            raise SsoIdentityVerificationError(
+                f"Feishu rejected the authorization code during token exchange (code={response.code})"
+            )
+        return response.data.access_token
+
+    async def _get_user_info(self, user_access_token: str) -> GetUserInfoResponseBody:
+        request = GetUserInfoRequest.builder().build()
+        option = RequestOption.builder().user_access_token(user_access_token).build()
+        try:
+            response = await asyncio.to_thread(
+                self._client.authen.v1.user_info.get, request, option
+            )
+        except requests.exceptions.RequestException as exc:
+            raise SsoTemporaryError(f"Feishu user_info request failed: {exc}") from exc
+
+        if not response.success() or response.data is None:
+            logger.warning(
+                f"[portal][sso][feishu] user_info rejected: code={response.code}"
+            )
+            raise SsoIdentityVerificationError(
+                f"Feishu rejected the user_info request (code={response.code})"
+            )
+        return response.data
+
+
+__all__ = ["FeishuProvider"]
diff --git c/astrbot/portal/services/sso/oidc.py w/astrbot/portal/services/sso/oidc.py
new file mode 100644
index 00000000..090b05e6
--- /dev/null
+++ w/astrbot/portal/services/sso/oidc.py
@@ -0,0 +1,436 @@
+"""Generic OpenID Connect authorization-code adapter -- built on ``pyjwt`` and
+``httpx`` only, per this phase's explicit decision (``authlib`` deliberately
+NOT added; see this phase's handoff report if that decision is ever revisited).
+
+Trust basis: :attr:`~astrbot.portal.services.sso.base.SsoTrustBasis.SIGNED_ASSERTION`.
+Every identity this adapter returns is backed by an ``id_token`` whose
+signature was verified against the issuer's own published JWKS, with
+``iss``/``aud``/``exp``/``iat``/``nonce`` all checked -- see
+:meth:`OidcProvider.resolve_identity` for the exact order and the
+algorithm-confusion defense, which is the single most important property of
+this file (see module-level ``_ALLOWED_SIGNING_ALGORITHMS`` comment).
+
+Flow implemented, end to end:
+
+1. :meth:`build_authorization_request` -- fetches (and caches) the
+   provider's discovery document, generates ``state``/``nonce``/PKCE
+   ``code_verifier``+``code_challenge`` (S256), and builds the
+   authorization-endpoint redirect URL.
+2. :meth:`resolve_identity` -- exchanges the authorization code for tokens
+   over ``httpx`` with client authentication and a hard timeout, then
+   verifies the returned ``id_token`` via ``jwt.PyJWKClient`` (signature)
+   plus explicit ``iss``/``aud``/``exp``/``iat``/``nbf``/``nonce`` checks
+   with a bounded clock-skew allowance, and returns the resolved
+   :class:`~astrbot.portal.services.sso.base.VerifiedIdentity` -- ``sub``,
+   never the email, as the stable subject.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import secrets
+import time
+from collections.abc import Mapping
+from typing import Any
+from urllib.parse import urlencode
+
+import httpx
+import jwt
+
+from astrbot.core import logger
+from astrbot.portal.config import SSO_PROVIDER_OIDC
+from astrbot.portal.services.sso.base import (
+    AuthorizationRequest,
+    SsoDiscoveryError,
+    SsoIdentityVerificationError,
+    SsoTemporaryError,
+    SsoTrustBasis,
+    VerifiedIdentity,
+)
+
+_HTTP_TIMEOUT_SECONDS = 10.0
+"""Hard timeout applied to every outbound HTTP call this adapter makes
+(discovery fetch, token exchange, JWKS fetch via PyJWKClient) -- a slow or
+hanging IdP must never be able to tie up a portal worker indefinitely."""
+
+_DISCOVERY_CACHE_TTL_SECONDS = 3600
+"""How long a fetched discovery document is reused before being re-fetched.
+Long enough that every request does not hit the network, short enough that
+a provider rotating its endpoints/JWKS URI is picked up within the hour
+without a process restart."""
+
+_JWKS_CLIENT_LIFESPAN_SECONDS = 300
+"""``PyJWKClient``'s own internal signing-key cache TTL (its ``lifespan``
+constructor arg) -- separate from, and much shorter than, the discovery
+cache above, since keys rotate far more often than endpoint URLs and a
+stale key would hard-fail verification (a security failure mode, not a
+silent one) rather than a stale endpoint (which would 404)."""
+
+_CLOCK_SKEW_SECONDS = 120
+"""Bounded clock-skew allowance applied uniformly to ``exp``/``iat``/``nbf``
+checks (PyJWT's single ``leeway`` parameter covers all three). Generous
+enough to absorb ordinary NTP drift between this host and the IdP, narrow
+enough that a token genuinely outside its validity window is still
+rejected."""
+
+_ALLOWED_SIGNING_ALGORITHMS: tuple[str, ...] = (
+    "RS256",
+    "RS384",
+    "RS512",
+    "ES256",
+    "ES384",
+    "ES512",
+    "PS256",
+    "PS384",
+    "PS512",
+)
+"""Static, hardcoded allowlist of acceptable ``id_token`` signing algorithms
+-- asymmetric only. This is deliberately **never** derived from the
+token's own header, from the JWKS entry PyJWKClient happens to match, or
+from any other attacker-influenceable input: PyJWT's own documentation is
+explicit that computing the ``algorithms`` argument from the token itself
+is exactly how classic algorithm-confusion vulnerabilities happen (e.g. an
+attacker presents ``alg: HS256`` and signs with the provider's *public* RSA
+key re-interpreted as an HMAC secret, or presents ``alg: none`` and no
+signature at all). By hardcoding this list independently of anything the
+request/response carries, both of those attacks are structurally
+impossible regardless of what a forged token's header claims: PyJWT's
+``jwt.decode(..., algorithms=[...])`` only accepts a token whose header
+``alg`` is a member of the list *we* pass, and this list contains no
+symmetric algorithm and no ``none``."""
+
+
+class OidcProvider:
+    """Generic OIDC authorization-code adapter. See module docstring."""
+
+    provider_id = SSO_PROVIDER_OIDC
+    trust_basis = SsoTrustBasis.SIGNED_ASSERTION
+
+    def __init__(
+        self,
+        *,
+        client_id: str,
+        client_secret: str,
+        issuer: str | None,
+        discovery_url: str | None = None,
+        scopes: tuple[str, ...] = ("openid", "email", "profile"),
+        http_timeout_seconds: float = _HTTP_TIMEOUT_SECONDS,
+    ) -> None:
+        if not client_id or not client_secret:
+            raise ValueError("OidcProvider requires both client_id and client_secret")
+        if not issuer and not discovery_url:
+            raise ValueError("OidcProvider requires issuer or discovery_url")
+
+        self._client_id = client_id
+        self._client_secret = client_secret
+        self._issuer = issuer.rstrip("/") if issuer else None
+        self._discovery_url = discovery_url or (
+            f"{self._issuer}/.well-known/openid-configuration"
+        )
+        self._scopes = scopes
+        self._timeout = http_timeout_seconds
+
+        self._discovery_cache: dict[str, Any] | None = None
+        self._discovery_cache_at: float = 0.0
+        self._discovery_lock = asyncio.Lock()
+
+        self._jwk_client: jwt.PyJWKClient | None = None
+        self._jwk_client_jwks_uri: str | None = None
+
+    # -- discovery -----------------------------------------------------
+
+    async def _get_discovery(self) -> dict[str, Any]:
+        """Fetch-or-return-cached discovery document.
+
+        Discovery is preferred over hand-configured endpoints per this
+        phase's decision: it is the provider's own authoritative statement
+        of its ``authorization_endpoint``/``token_endpoint``/``jwks_uri``,
+        and it self-certifies its own ``issuer`` (checked below), which a
+        set of hand-entered URLs cannot do.
+        """
+        async with self._discovery_lock:
+            now = time.monotonic()
+            if (
+                self._discovery_cache is not None
+                and (now - self._discovery_cache_at) < _DISCOVERY_CACHE_TTL_SECONDS
+            ):
+                return self._discovery_cache
+
+            try:
+                async with httpx.AsyncClient(timeout=self._timeout) as client:
+                    response = await client.get(self._discovery_url)
+                    response.raise_for_status()
+                    doc = response.json()
+            except httpx.HTTPError as exc:
+                raise SsoTemporaryError(
+                    f"OIDC discovery fetch failed for {self._discovery_url!r}: {exc}"
+                ) from exc
+            except ValueError as exc:
+                raise SsoDiscoveryError(
+                    "OIDC discovery document is not valid JSON"
+                ) from exc
+
+            if not isinstance(doc, dict):
+                raise SsoDiscoveryError("OIDC discovery document is not a JSON object")
+
+            for required_field in (
+                "authorization_endpoint",
+                "token_endpoint",
+                "jwks_uri",
+                "issuer",
+            ):
+                if not doc.get(required_field):
+                    raise SsoDiscoveryError(
+                        f"OIDC discovery document missing required field {required_field!r}"
+                    )
+
+            doc_issuer = str(doc["issuer"]).rstrip("/")
+            if self._issuer is not None and doc_issuer != self._issuer:
+                # Fail closed: a discovery document whose self-declared
+                # issuer does not match the configured issuer is either a
+                # misconfiguration or a redirection attack -- either way,
+                # never proceed with endpoints from a document that failed
+                # to self-certify.
+                raise SsoDiscoveryError(
+                    "OIDC discovery document's issuer "
+                    f"({doc_issuer!r}) does not match configured issuer "
+                    f"({self._issuer!r})"
+                )
+            # Adopt the (now-verified) issuer for later id_token `iss` checks
+            # even if this adapter was constructed with `issuer=None` and a
+            # bare `discovery_url` override.
+            self._issuer = doc_issuer
+
+            self._discovery_cache = doc
+            self._discovery_cache_at = now
+            return doc
+
+    def _get_jwk_client(self, jwks_uri: str) -> jwt.PyJWKClient:
+        if self._jwk_client is None or self._jwk_client_jwks_uri != jwks_uri:
+            self._jwk_client = jwt.PyJWKClient(
+                jwks_uri,
+                cache_keys=True,
+                lifespan=_JWKS_CLIENT_LIFESPAN_SECONDS,
+                timeout=self._timeout,
+            )
+            self._jwk_client_jwks_uri = jwks_uri
+        return self._jwk_client
+
+    # -- SsoProvider protocol --------------------------------------------
+
+    async def build_authorization_request(
+        self, *, redirect_uri: str
+    ) -> AuthorizationRequest:
+        discovery = await self._get_discovery()
+
+        state = secrets.token_urlsafe(32)
+        nonce = secrets.token_urlsafe(32)
+        # 64 raw bytes -> ~86 url-safe base64 chars, comfortably inside
+        # RFC 7636's required 43-128 character range for a PKCE code_verifier.
+        code_verifier = secrets.token_urlsafe(64)
+        code_challenge = _pkce_s256_challenge(code_verifier)
+
+        params = {
+            "response_type": "code",
+            "client_id": self._client_id,
+            "redirect_uri": redirect_uri,
+            "scope": " ".join(self._scopes),
+            "state": state,
+            "nonce": nonce,
+            "code_challenge": code_challenge,
+            "code_challenge_method": "S256",
+        }
+        authorize_url = f"{discovery['authorization_endpoint']}?{urlencode(params)}"
+
+        return AuthorizationRequest(
+            authorize_url=authorize_url,
+            state=state,
+            provider_state={"nonce": nonce, "code_verifier": code_verifier},
+        )
+
+    async def resolve_identity(
+        self,
+        *,
+        code: str,
+        redirect_uri: str,
+        provider_state: Mapping[str, str],
+    ) -> VerifiedIdentity:
+        expected_nonce = provider_state.get("nonce")
+        code_verifier = provider_state.get("code_verifier")
+        if not expected_nonce or not code_verifier:
+            raise SsoIdentityVerificationError(
+                "Missing nonce/code_verifier for this OIDC flow; refusing to "
+                "verify an id_token with no nonce to check it against"
+            )
+
+        discovery = await self._get_discovery()
+
+        token_response = await self._exchange_code(
+            token_endpoint=discovery["token_endpoint"],
+            code=code,
+            redirect_uri=redirect_uri,
+            code_verifier=code_verifier,
+        )
+
+        id_token = token_response.get("id_token")
+        if not id_token or not isinstance(id_token, str):
+            raise SsoIdentityVerificationError(
+                "OIDC token response did not include an id_token"
+            )
+
+        claims = await self._verify_id_token(id_token, jwks_uri=discovery["jwks_uri"])
+
+        token_nonce = claims.get("nonce")
+        if not token_nonce or not hmac.compare_digest(
+            str(token_nonce), str(expected_nonce)
+        ):
+            raise SsoIdentityVerificationError(
+                "id_token nonce does not match the nonce issued for this flow"
+            )
+
+        subject = claims.get("sub")
+        if not subject or not isinstance(subject, str):
+            raise SsoIdentityVerificationError("id_token is missing a sub claim")
+
+        email = claims.get("email")
+        email = email if isinstance(email, str) and email else None
+
+        email_verified_claim = claims.get("email_verified")
+        # Some providers encode this as a real bool, a few non-compliant
+        # ones as the string "true"/"false". Absence of the claim entirely
+        # -- or any other shape -- is treated as unverified, never as
+        # verified-by-omission (per this phase's explicit instruction).
+        email_verified = email_verified_claim is True or (
+            isinstance(email_verified_claim, str)
+            and email_verified_claim.strip().lower() == "true"
+        )
+
+        display_name = claims.get("name") or claims.get("preferred_username")
+        display_name = display_name if isinstance(display_name, str) and display_name else None
+
+        return VerifiedIdentity(
+            provider=self.provider_id,
+            subject=subject,
+            trust_basis=self.trust_basis,
+            email=email,
+            email_verified=email_verified,
+            display_name=display_name,
+            raw={"claims": claims},
+        )
+
+    # -- internals ---------------------------------------------------------
+
+    async def _exchange_code(
+        self,
+        *,
+        token_endpoint: str,
+        code: str,
+        redirect_uri: str,
+        code_verifier: str,
+    ) -> dict[str, Any]:
+        """Authorization-code-for-token exchange over ``httpx``.
+
+        Client authentication via ``client_secret_post`` (client id/secret
+        in the POST body) -- chosen over ``client_secret_basic`` (HTTP Basic
+        auth) because it is the one method essentially every OIDC provider
+        in scope for a "generic" client (Google, Microsoft Entra, Keycloak,
+        Authentik, Auth0) supports without additional per-deployment
+        configuration; a deployment whose provider *requires*
+        ``client_secret_basic`` instead is a known, documented gap (see this
+        phase's handoff report) rather than a silently broken integration.
+        """
+        try:
+            async with httpx.AsyncClient(timeout=self._timeout) as client:
+                response = await client.post(
+                    token_endpoint,
+                    data={
+                        "grant_type": "authorization_code",
+                        "code": code,
+                        "redirect_uri": redirect_uri,
+                        "client_id": self._client_id,
+                        "client_secret": self._client_secret,
+                        "code_verifier": code_verifier,
+                    },
+                    headers={"Accept": "application/json"},
+                )
+        except httpx.HTTPError as exc:
+            raise SsoTemporaryError(f"OIDC token exchange request failed: {exc}") from exc
+
+        if response.status_code != 200:
+            logger.warning(
+                f"[portal][sso][oidc] token exchange rejected by provider: "
+                f"status={response.status_code}"
+            )
+            raise SsoIdentityVerificationError(
+                f"OIDC token exchange rejected by provider (status {response.status_code})"
+            )
+
+        try:
+            data = response.json()
+        except ValueError as exc:
+            raise SsoIdentityVerificationError(
+                "OIDC token response is not valid JSON"
+            ) from exc
+
+        if not isinstance(data, dict):
+            raise SsoIdentityVerificationError("OIDC token response is not a JSON object")
+
+        return data
+
+    async def _verify_id_token(self, id_token: str, *, jwks_uri: str) -> dict[str, Any]:
+        """Signature verification via ``jwt.PyJWKClient``, then explicit
+        ``iss``/``aud``/``exp``/``iat``/``nbf`` checks with bounded clock
+        skew. See ``_ALLOWED_SIGNING_ALGORITHMS`` above for the
+        algorithm-confusion defense this method depends on.
+        """
+        jwk_client = self._get_jwk_client(jwks_uri)
+        try:
+            # PyJWKClient.get_signing_key_from_jwt performs blocking network
+            # I/O (JWKS fetch on cache miss) -- run it off the event loop
+            # rather than blocking every other in-flight request on this
+            # worker while it happens.
+            signing_key = await asyncio.to_thread(
+                jwk_client.get_signing_key_from_jwt, id_token
+            )
+        except jwt.PyJWKClientError as exc:
+            raise SsoIdentityVerificationError(
+                f"Could not resolve a signing key for this id_token: {exc}"
+            ) from exc
+        except httpx.HTTPError as exc:  # pragma: no cover - PyJWKClient uses urllib, not httpx
+            raise SsoTemporaryError(f"JWKS fetch failed: {exc}") from exc
+
+        try:
+            claims = jwt.decode(
+                id_token,
+                key=signing_key.key,
+                # Hardcoded allowlist, NOT derived from the token header or
+                # from signing_key.algorithm_name -- see module-level
+                # constant's docstring for why that distinction is the
+                # entire point.
+                algorithms=list(_ALLOWED_SIGNING_ALGORITHMS),
+                audience=self._client_id,
+                issuer=self._issuer,
+                leeway=_CLOCK_SKEW_SECONDS,
+                options={"require": ["exp", "iat", "sub"]},
+            )
+        except jwt.InvalidTokenError as exc:
+            raise SsoIdentityVerificationError(
+                f"id_token failed verification: {exc}"
+            ) from exc
+
+        if not isinstance(claims, dict):  # pragma: no cover - defensive
+            raise SsoIdentityVerificationError("id_token payload is not a JSON object")
+
+        return claims
+
+
+def _pkce_s256_challenge(code_verifier: str) -> str:
+    """RFC 7636 S256 code_challenge: base64url(sha256(code_verifier)), no padding."""
+    digest = hashlib.sha256(code_verifier.encode("ascii")).digest()
+    return base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
+
+
+__all__ = ["OidcProvider"]
