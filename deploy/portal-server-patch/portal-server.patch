new file mode 100644
index 00000000..a96ac7b0
--- /dev/null
+++ w/astrbot/portal/api/chat_routes.py
@@ -0,0 +1,652 @@
+"""End-user chat HTTP routes for the AstrBot Portal module.
+
+Every handler here goes through :mod:`astrbot.portal.services.core_facade` --
+the single, audited seam that is allowed to reach ``ChatService``. This file
+must never import ``ChatService``, ``ConversationService``,
+``SessionManagementService``, ``conv_mgr``, or any other capability-wall
+member directly (rule 5 of the module's engineering rules); doing so would
+fail the import-linter contract. Every ``user_id`` used below comes from
+:func:`astrbot.portal.auth.dependencies.get_current_user` -- never from a
+request body, query string, or header -- so the ownership checks already
+built into ``core_facade``/``ChatService`` (plain ``creator``/``username``
+string comparisons) give per-user isolation "for free".
+
+Two deliberate Phase 1 security-scoping decisions beyond the assignment's
+literal endpoint list, both flowing directly from facts already verified
+for this module:
+
+1. **No client-supplied provider/model routing.** Neither
+   :class:`SendMessageRequest` nor any other request model below declares a
+   ``selected_provider``/``selected_model`` field, and every one of them
+   sets ``model_config = ConfigDict(extra="ignore")`` -- so even if a
+   client includes those keys in the JSON body, pydantic silently drops
+   them before this module ever sees them. Nothing here ever reads,
+   echoes, or forwards those two keys (see
+   ``astr_main_agent.py:223-237``: ``_select_provider`` trusts them with no
+   authorization check at all).
+2. **Multimodal message bodies require a verified owner (Phase 2).**
+   ``SendMessageRequest.message`` now accepts the ``str | list`` union
+   :func:`core_facade.send_message` itself accepts (the list form carries
+   media parts referencing an ``attachment_id``), and
+   :func:`_validate_message_parts_shape` performs the equivalent basic
+   shape check for a message-edit payload. Rationale for why this used to
+   be text-only and now is not: the core webchat message-parts pipeline
+   (``astrbot.core.platform.sources.webchat.message_parts_helper
+   .build_webchat_message_parts``) resolves any non-``plain``/``reply``
+   part purely by ``attachment_id`` via ``get_attachment_by_id`` -- and
+   ``Attachment`` has no owner column at all (verified ground truth: see
+   ``astrbot/core/db/po.py:340-361``). Phase 1 shipped no upload endpoint
+   and no ownership table, so accepting a list-shaped payload then would
+   have let any authenticated portal user embed and have rendered an
+   attachment_id belonging to a *different* user -- a cross-tenant IDOR
+   with no ownership check anywhere in the chain. Phase 2 closes that gap
+   with the ``PortalAttachmentOwner`` shadow-ownership table (db/models.py)
+   plus ``attachment_service.assert_owns_all``, its batch-ownership check:
+   every route below
+   that can carry a media part now passes
+   ``attachment_service.assert_owns_all`` as ``core_facade.send_message``/
+   ``update_message``'s ``verify_attachment_ownership`` argument, which
+   ``core_facade`` calls with every distinct ``attachment_id`` in the
+   sanitized parts *before* ``ChatService`` is ever invoked; a miss (row
+   absent, or owned by someone else) raises
+   ``core_facade.ResourceNotFoundError`` -> HTTP 404 for the *whole*
+   request, never a partial/best-effort accept.
+
+Per-user concurrent-run limiting (the "CONTRACT for chat_routes.py" in
+``auth/rate_limit.py``'s module docstring) is implemented in
+:func:`_acquire_run_slot`/:func:`_release_run_slot`: the DB-backed
+``PortalUsageCounter`` row is the authoritative check-and-increment (a single
+transaction, upsert-on-conflict to avoid the documented
+``UniqueConstraint(user_id, window_start)`` race), backed by the
+process-local ``InProcessConcurrencyGuard`` as a fast-path/defense-in-depth
+layer on top. Both are released when the SSE stream this route serves
+finishes (normally, on error, or on client disconnect), via
+:func:`_guarded_run_stream`'s ``finally`` block -- not when some notion of
+"the underlying ChatService run" finishes, which this module has no direct
+visibility into.
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from datetime import datetime, timezone
+from typing import Any, NoReturn
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request
+from fastapi.responses import StreamingResponse
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+from sqlalchemy import select
+from sqlalchemy.exc import IntegrityError
+
+from astrbot import logger
+from astrbot.portal.auth.dependencies import get_current_user, require_csrf
+from astrbot.portal.auth.rate_limit import (
+    can_start_run_for_counter,
+    get_concurrency_guard,
+)
+from astrbot.portal.config import get_portal_settings
+from astrbot.portal.db.engine import portal_async_sessionmaker
+from astrbot.portal.db.models import PortalUsageCounter, PortalUser
+from astrbot.portal.services import attachment_service, core_facade
+from astrbot.portal.services.core_facade import (
+    CoreFacadeError,
+    ResourceNotFoundError,
+    ValidationError,
+)
+
+router = APIRouter(prefix="/chat", tags=["Portal Chat"])
+"""Mounted by ``astrbot.portal.api.router.portal_router`` (prefix ``/portal``),
+itself mounted under ``/api/v1`` by the dashboard's ``build_api_router`` --
+so every path below ends up public at ``/api/v1/portal/chat/...``, matching
+this assignment's endpoint list verbatim. This router must NOT declare its
+own ``/portal`` prefix (that would double it up to ``/portal/portal/chat/...``
+once the aggregate router in ``api/router.py`` applies its own)."""
+
+_SSE_HEADERS = {
+    "Cache-Control": "no-cache",
+    "Transfer-Encoding": "chunked",
+    "Connection": "keep-alive",
+}
+"""Identical to the header set ``astrbot.dashboard.api.chat._send_chat`` uses
+for its ``StreamingResponse`` -- keeping these byte-identical is part of
+preserving the SSE contract the reused frontend renderer depends on."""
+
+
+# ---------------------------------------------------------------------------
+# Request models. Every one of them sets extra="ignore" so stray client
+# fields (most importantly selected_provider/selected_model -- see module
+# docstring, invariant 1) are silently dropped rather than stored or
+# accessible anywhere in this module.
+# ---------------------------------------------------------------------------
+
+
+class SessionRenameRequest(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+
+    display_name: str = Field(min_length=1, max_length=200)
+
+
+class BatchDeleteRequest(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+
+    session_ids: list[str] = Field(min_length=1, max_length=200)
+
+
+class MessagePart(BaseModel):
+    """One element of the Phase 2 multimodal ``message`` list form.
+
+    This model's job is basic shape/type validation ONLY -- it is
+    deliberately NOT the security boundary. ``core_facade
+    ._sanitize_message_parts`` is the authoritative whitelist filter
+    (down to exactly ``{type, attachment_id, filename, text, message_id,
+    selected_text}``) applied again, unconditionally, just before anything
+    reaches ``ChatService`` -- so a client-supplied ``path`` or
+    ``stored_filename`` key validates fine here (``extra="ignore"`` simply
+    drops it) but can never survive past ``core_facade`` regardless of
+    what this model does or does not strip. Ownership of any
+    ``attachment_id`` present is verified downstream by
+    ``attachment_service.assert_owns_all``, injected as ``core_facade
+    .send_message``'s ``verify_attachment_ownership`` argument -- never
+    here.
+    """
+
+    model_config = ConfigDict(extra="ignore")
+
+    type: str
+    text: str | None = None
+    attachment_id: str | None = None
+    filename: str | None = None
+    message_id: int | None = None
+    selected_text: str | None = None
+
+
+class SendMessageRequest(BaseModel):
+    """``message`` accepts either plain text or the Phase 2 multimodal list
+    form -- see module docstring, invariant 2, for the ownership-
+    verification contract every list-shaped payload goes through before it
+    ever reaches ``core_facade.send_message``."""
+
+    model_config = ConfigDict(extra="ignore")
+
+    message: str | list[MessagePart]
+    flags: dict[str, bool] | None = None
+
+    @field_validator("message")
+    @classmethod
+    def _validate_message(
+        cls, value: str | list[MessagePart]
+    ) -> str | list[MessagePart]:
+        if isinstance(value, str):
+            if not value.strip():
+                raise ValueError("message must not be blank")
+            return value
+        if not value:
+            raise ValueError("message list must not be empty")
+        return value
+
+
+def _message_parts_payload(
+    message: str | list[MessagePart],
+) -> str | list[dict[str, Any]]:
+    """Convert the validated request model's ``message`` into the plain
+    ``str | list[dict]`` shape ``core_facade.send_message`` expects.
+
+    This conversion matters, not just for convenience: ``core_facade
+    ._sanitize_message_parts`` does ``isinstance(part, dict)`` and silently
+    *drops* anything that is not a plain dict, so handing it a list of
+    ``MessagePart`` model instances directly would make every media part
+    vanish rather than raise -- a silent request-corruption bug, not a
+    visible error. ``exclude_none=True`` keeps the dict shape close to what
+    a client actually sent (no ``attachment_id: null`` on a plain-text
+    part), which is harmless either way since ``core_facade`` only reads
+    keys that are actually present.
+    """
+    if isinstance(message, str):
+        return message
+    return [part.model_dump(exclude_none=True) for part in message]
+
+
+class MessageEditRequest(BaseModel):
+    model_config = ConfigDict(extra="ignore")
+
+    content: dict[str, Any]
+
+
+# Same vocabulary core's own webchat message-parts pipeline recognizes
+# (``message_parts_helper.MEDIA_PART_TYPES`` plus ``plain``/``reply``) --
+# duplicated here (not imported) for the same reason ``core_facade.py``
+# duplicates its own copy of this set: importing a helper from that core
+# submodule just to get one constant is not worth a new capability-wall
+# surface, and this vocabulary has been stable since Phase 1.
+_ALLOWED_EDIT_PART_TYPES = frozenset(
+    {"plain", "reply", "image", "record", "file", "video"}
+)
+
+
+def _validate_message_parts_shape(content: dict[str, Any]) -> None:
+    """Basic shape/type validation for a message-edit payload's
+    ``content.message`` list -- NOT the ownership check.
+
+    See module docstring, invariant 2: ``ChatService.update_message``'s own
+    ``sanitize_message_content`` only checks that ``content.message`` is a
+    list and strips ``path`` fields -- it does **not** re-resolve each
+    part's ``attachment_id`` against ``get_attachment_by_id`` the way the
+    send-message path does, so it provides no ownership check at all for
+    whatever shape the client hands it. That check happens downstream,
+    in ``core_facade.update_message``, via the ``attachment_service
+    .assert_owns_all`` verifier the caller below injects -- this function
+    only rejects payloads whose *shape* is not even worth forwarding.
+    """
+    parts = content.get("message")
+    if not isinstance(parts, list) or not parts:
+        raise HTTPException(
+            status_code=400, detail="content.message must be a non-empty list"
+        )
+    for part in parts:
+        if not isinstance(part, dict) or part.get("type") not in (
+            _ALLOWED_EDIT_PART_TYPES
+        ):
+            raise HTTPException(
+                status_code=400,
+                detail="Unsupported or missing message part type",
+            )
+
+
+# ---------------------------------------------------------------------------
+# core_facade error translation. ResourceNotFoundError -> 404 (never 403,
+# so ownership failures are indistinguishable from "does not exist" --
+# rule 3 of core_facade's own security checklist). ValidationError -> 400.
+# ---------------------------------------------------------------------------
+
+
+def _raise_for_core_error(exc: CoreFacadeError) -> NoReturn:
+    if isinstance(exc, ResourceNotFoundError):
+        raise HTTPException(status_code=404, detail=str(exc) or "Not found") from exc
+    if isinstance(exc, ValidationError):
+        raise HTTPException(
+            status_code=400, detail=str(exc) or "Invalid request"
+        ) from exc
+    raise HTTPException(status_code=400, detail=str(exc)) from exc
+
+
+# ---------------------------------------------------------------------------
+# Per-user concurrent chat-run limiting. DB-backed PortalUsageCounter is the
+# authoritative, restart-surviving check-and-increment; InProcessConcurrency
+# Guard is a same-process fast-path/defense-in-depth layer on top of it, per
+# auth/rate_limit.py's module docstring. Both use fresh, self-managed DB
+# sessions (not a FastAPI Depends()-injected one) because the slot must be
+# released from inside the SSE stream's own teardown, long after any
+# request-scoped dependency would already have been torn down.
+# ---------------------------------------------------------------------------
+
+
+def _window_start(now: datetime | None = None) -> datetime:
+    settings = get_portal_settings()
+    window_seconds = max(int(settings.usage_window_seconds), 1)
+    now = now or datetime.now(timezone.utc)
+    epoch = int(now.timestamp())
+    return datetime.fromtimestamp(
+        (epoch // window_seconds) * window_seconds, tz=timezone.utc
+    )
+
+
+async def _load_or_create_counter(
+    session, user_id: str, window_start: datetime
+) -> PortalUsageCounter | None:
+    """Fetch this user's usage-counter row for ``window_start``, creating it
+    on first use. Returns ``None`` if a concurrent insert raced us twice in
+    a row (the caller must treat that as "try again later", not a bug)."""
+    for _ in range(2):
+        result = await session.execute(
+            select(PortalUsageCounter).where(
+                PortalUsageCounter.user_id == user_id,
+                PortalUsageCounter.window_start == window_start,
+            )
+        )
+        counter = result.scalar_one_or_none()
+        if counter is not None:
+            return counter
+
+        counter = PortalUsageCounter(
+            user_id=user_id,
+            window_start=window_start,
+            request_count=0,
+            concurrent_runs=0,
+        )
+        session.add(counter)
+        try:
+            await session.flush()
+            return counter
+        except IntegrityError:
+            # Another concurrent request for the same (user_id, window_start)
+            # inserted first (UniqueConstraint race) -- re-fetch instead of
+            # blind-inserting again.
+            await session.rollback()
+    return None
+
+
+async def _acquire_run_slot(user_id: str) -> datetime:
+    """Reserve one concurrent-run slot for ``user_id``.
+
+    Raises ``HTTPException(429)`` if the user is already at their
+    concurrent-run cap (``PortalSettings.max_concurrent_runs_per_user``) on
+    either the DB-backed or in-process layer. Returns the ``window_start``
+    used, so the caller releases against the exact same row later even if
+    the accounting window rolls over mid-run.
+    """
+    settings = get_portal_settings()
+    window_start = _window_start()
+
+    async with portal_async_sessionmaker() as session:
+        counter = await _load_or_create_counter(session, user_id, window_start)
+        if counter is None:
+            raise HTTPException(status_code=429, detail="请求过于频繁，请稍后重试")
+        if not can_start_run_for_counter(counter, settings=settings):
+            await session.rollback()
+            raise HTTPException(
+                status_code=429, detail="并发对话数已达上限，请稍后重试"
+            )
+        counter.concurrent_runs += 1
+        counter.request_count += 1
+        await session.commit()
+
+    if not await get_concurrency_guard().try_acquire(user_id):
+        # DB slot was granted but the in-process guard is already full
+        # (e.g. stale DB counters after a mid-process crash) -- release the
+        # DB slot we just took and fail closed rather than over-admit.
+        await _release_run_slot(user_id, window_start, release_in_process=False)
+        raise HTTPException(status_code=429, detail="并发对话数已达上限，请稍后重试")
+
+    return window_start
+
+
+async def _release_run_slot(
+    user_id: str, window_start: datetime, *, release_in_process: bool = True
+) -> None:
+    async with portal_async_sessionmaker() as session:
+        result = await session.execute(
+            select(PortalUsageCounter).where(
+                PortalUsageCounter.user_id == user_id,
+                PortalUsageCounter.window_start == window_start,
+            )
+        )
+        counter = result.scalar_one_or_none()
+        if counter is not None and counter.concurrent_runs > 0:
+            counter.concurrent_runs -= 1
+            await session.commit()
+        else:
+            await session.rollback()
+
+    if release_in_process:
+        await get_concurrency_guard().release(user_id)
+
+
+def _guarded_run_stream(
+    stream: AsyncIterator[str], user_id: str, window_start: datetime
+) -> AsyncIterator[str]:
+    """Wrap an SSE stream so the concurrency slot acquired for it is always
+    released once the stream ends -- normal completion, an error inside the
+    generator, or the client disconnecting (which raises ``GeneratorExit``
+    at the ``async for`` below, still caught by ``finally``)."""
+
+    async def _wrapped() -> AsyncIterator[str]:
+        try:
+            async for chunk in stream:
+                yield chunk
+        finally:
+            try:
+                await _release_run_slot(user_id, window_start)
+            except Exception:
+                logger.exception(
+                    f"[portal] failed to release chat-run concurrency slot "
+                    f"for user {user_id}"
+                )
+
+    return _wrapped()
+
+
+# ---------------------------------------------------------------------------
+# Sessions
+# ---------------------------------------------------------------------------
+
+
+@router.get("/sessions")
+async def list_chat_sessions(
+    request: Request,
+    page: int = Query(default=1, ge=1),
+    page_size: int = Query(default=20, ge=1, le=100),
+    current_user: PortalUser = Depends(get_current_user),
+) -> dict[str, Any]:
+    try:
+        sessions = await core_facade.list_sessions(current_user.user_id, request)
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+    total = len(sessions)
+    start = (page - 1) * page_size
+    page_items = sessions[start : start + page_size]
+    total_pages = (total + page_size - 1) // page_size if total > 0 else 1
+    return {
+        "sessions": page_items,
+        "pagination": {
+            "page": page,
+            "page_size": page_size,
+            "total": total,
+            "total_pages": total_pages,
+        },
+    }
+
+
+@router.post("/sessions", status_code=201)
+async def create_chat_session(
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    try:
+        return await core_facade.create_session(current_user.user_id, request)
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.post("/sessions/batch-delete")
+async def batch_delete_chat_sessions(
+    payload: BatchDeleteRequest,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    try:
+        return await core_facade.batch_delete_sessions(
+            current_user.user_id, request, payload.session_ids
+        )
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.get("/sessions/{session_id}")
+async def get_chat_session(
+    session_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+) -> dict[str, Any]:
+    try:
+        return await core_facade.get_owned_session(
+            current_user.user_id, request, session_id
+        )
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.patch("/sessions/{session_id}")
+async def rename_chat_session(
+    session_id: str,
+    payload: SessionRenameRequest,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    try:
+        return await core_facade.rename_session(
+            current_user.user_id, request, session_id, payload.display_name
+        )
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.delete("/sessions/{session_id}", status_code=204)
+async def delete_chat_session(
+    session_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> None:
+    try:
+        await core_facade.delete_session(current_user.user_id, request, session_id)
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+# ---------------------------------------------------------------------------
+# Messaging / streaming. Frame contract preserved verbatim: `data:
+# {json}\n\n`, heartbeat `: heartbeat\n\n`, frame types
+# plain/image/record/file/video/end/complete/agent_stats/attachment_saved/
+# message_saved/error (see chat_service.py:787-1046) -- these routes never
+# touch the stream's bytes, only pass the AsyncIterator straight into
+# StreamingResponse, so the reused frontend renderer works unchanged.
+# ---------------------------------------------------------------------------
+
+
+@router.post("/sessions/{session_id}/messages")
+async def send_chat_message(
+    session_id: str,
+    payload: SendMessageRequest,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> StreamingResponse:
+    user_id = current_user.user_id
+    window_start = await _acquire_run_slot(user_id)
+    try:
+        stream = await core_facade.send_message(
+            user_id,
+            request,
+            session_id,
+            _message_parts_payload(payload.message),
+            flags=payload.flags,
+            verify_attachment_ownership=attachment_service.assert_owns_all,
+        )
+    except CoreFacadeError as exc:
+        await _release_run_slot(user_id, window_start)
+        _raise_for_core_error(exc)
+    except Exception:
+        await _release_run_slot(user_id, window_start)
+        raise
+
+    return StreamingResponse(
+        _guarded_run_stream(stream, user_id, window_start),
+        media_type="text/event-stream",
+        headers=_SSE_HEADERS,
+    )
+
+
+@router.get("/runs/{run_id}/stream")
+async def stream_chat_run(
+    run_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+) -> StreamingResponse:
+    """SSE resume/attach endpoint. ``run_id`` is attacker-guessable, so
+    ownership is verified by ``core_facade.stream_run`` synchronously --
+    before this function ever constructs a ``StreamingResponse`` -- and a
+    mismatch surfaces as ``ResourceNotFoundError`` -> HTTP 404 (never 403),
+    so not a single byte of another user's run is ever emitted."""
+    try:
+        stream = await core_facade.stream_run(current_user.user_id, request, run_id)
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+    return StreamingResponse(
+        stream, media_type="text/event-stream", headers=_SSE_HEADERS
+    )
+
+
+@router.post("/sessions/{session_id}/stop")
+async def stop_chat_session(
+    session_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    try:
+        return await core_facade.stop_run(current_user.user_id, request, session_id)
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.patch("/sessions/{session_id}/messages/{message_id}")
+async def edit_chat_message(
+    session_id: str,
+    message_id: int,
+    payload: MessageEditRequest,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    if payload.content.get("type") != "user":
+        raise HTTPException(
+            status_code=400, detail="Only user messages can be edited"
+        )
+    _validate_message_parts_shape(payload.content)
+    try:
+        return await core_facade.update_message(
+            current_user.user_id,
+            request,
+            session_id,
+            message_id,
+            payload.content,
+            verify_attachment_ownership=attachment_service.assert_owns_all,
+        )
+    except CoreFacadeError as exc:
+        _raise_for_core_error(exc)
+
+
+@router.post("/sessions/{session_id}/messages/{message_id}/regenerate")
+async def regenerate_chat_message(
+    session_id: str,
+    message_id: int,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> StreamingResponse:
+    user_id = current_user.user_id
+    window_start = await _acquire_run_slot(user_id)
+    try:
+        stream = await core_facade.regenerate(user_id, request, session_id, message_id)
+    except CoreFacadeError as exc:
+        await _release_run_slot(user_id, window_start)
+        _raise_for_core_error(exc)
+    except Exception:
+        await _release_run_slot(user_id, window_start)
+        raise
+
+    return StreamingResponse(
+        _guarded_run_stream(stream, user_id, window_start),
+        media_type="text/event-stream",
+        headers=_SSE_HEADERS,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Chat configs
+# ---------------------------------------------------------------------------
+
+
+@router.get("/configs")
+async def get_chat_configs(
+    current_user: PortalUser = Depends(get_current_user),
+) -> dict[str, Any]:
+    return await core_facade.get_chat_configs(current_user.user_id)
+
+
+__all__ = ["router"]
diff --git c/astrbot/portal/api/cors.py w/astrbot/portal/api/cors.py
new file mode 100644
index 00000000..f2509f7c
--- /dev/null
+++ w/astrbot/portal/api/cors.py
@@ -0,0 +1,128 @@
+"""CORS for the portal's end-user API, scoped to exactly that surface.
+
+The portal SPA used to be served by this same process at ``/portal``, so
+every call it made was same-origin and no CORS layer existed anywhere in
+AstrBot. The SPA now ships as its own project, which an operator may deploy
+either behind a reverse proxy onto one origin (recommended -- still
+same-origin, nothing here activates) or on a separate origin, which is what
+this module exists for.
+
+Two properties matter more than convenience here, and both are why this is a
+custom middleware rather than a bare ``app.add_middleware(CORSMiddleware,
+...)``:
+
+**1. It must not apply to the whole app.** Starlette's ``CORSMiddleware``
+has no path filter, so installing it app-wide would hand the configured
+origins credentialed access to every core dashboard endpoint as well. That is
+not theoretical: ``astrbot/dashboard/api/auth.py`` accepts the operator's
+``astrbot_dashboard_jwt`` **cookie** as proof of identity, so an operator with
+a live dashboard session carries ambient authority that a permitted origin
+could then drive from the browser. The end-user portal API is the only
+surface that needs cross-origin access, so it is the only one that gets it.
+
+**2. It must exclude the portal's own admin sub-tree.** ``/api/v1/portal/admin/*``
+(invites, user management, KB visibility, agent bundles) is gated by the core
+dashboard's ``require_system_scope``, i.e. by that same operator cookie -- not
+by a portal end-user session. Those pages are served from the operator
+dashboard, at the same origin as this API, so they never need CORS; granting
+it would re-open exactly the hole point 1 closes, just one path deeper.
+
+Wildcard origins are rejected at config-parse time rather than here -- see
+``PortalSettings.cors_allowed_origins``.
+"""
+
+from __future__ import annotations
+
+from fastapi import FastAPI
+from starlette.middleware.cors import CORSMiddleware
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+from astrbot.portal.config import PortalSettings
+
+PORTAL_API_PREFIX = "/api/v1/portal"
+"""Where ``build_api_router`` mounts ``portal_router`` (``/api/v1`` + ``/portal``)."""
+
+PORTAL_ADMIN_API_PREFIX = "/api/v1/portal/admin"
+"""Operator-only sub-tree of the above; deliberately excluded from CORS."""
+
+CORS_ALLOW_METHODS = ("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS")
+
+CORS_ALLOW_HEADERS = ("Content-Type", "Accept", "X-Portal-CSRF-Token")
+"""``X-Portal-CSRF-Token`` is load-bearing: the SPA echoes the CSRF cookie
+back in that header on every unsafe request (see
+``astrbot/portal/auth/dependencies.py``'s ``require_csrf``). Omitting it from
+the allowlist makes preflight fail on every write while reads keep working --
+a confusing half-broken state rather than an obvious one."""
+
+
+def _is_under(path: str, prefix: str) -> bool:
+    """Whether ``path`` is ``prefix`` itself or something nested beneath it.
+
+    Deliberately not a bare ``str.startswith``, which gets both boundaries
+    wrong in opposite directions: it would pull ``/api/v1/portal-internal``
+    into the portal surface, and it would push a hypothetical
+    ``/api/v1/portal/administrators`` route out of it (matching the
+    ``/api/v1/portal/admin`` exclusion and silently losing its CORS headers).
+    Requiring a path separator keeps both exact.
+    """
+    return path == prefix or path.startswith(prefix + "/")
+
+
+def is_cors_eligible_path(path: str) -> bool:
+    """The end-user portal API, minus its operator-only admin sub-tree."""
+    return _is_under(path, PORTAL_API_PREFIX) and not _is_under(
+        path, PORTAL_ADMIN_API_PREFIX
+    )
+
+
+class PortalScopedCORSMiddleware:
+    """Applies ``CORSMiddleware`` only to :func:`is_cors_eligible_path`.
+
+    Everything else -- the operator dashboard API, the portal admin sub-tree,
+    websockets -- reaches the inner app untouched, with no CORS headers added
+    and no preflight handling, exactly as before this middleware existed.
+    """
+
+    def __init__(self, app: ASGIApp, *, allow_origins: tuple[str, ...]) -> None:
+        self.app = app
+        self.cors_app = CORSMiddleware(
+            app,
+            allow_origins=list(allow_origins),
+            allow_credentials=True,
+            allow_methods=list(CORS_ALLOW_METHODS),
+            allow_headers=list(CORS_ALLOW_HEADERS),
+        )
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] == "http" and is_cors_eligible_path(scope.get("path", "")):
+            await self.cors_app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+
+
+def install_portal_cors(app: FastAPI, settings: PortalSettings) -> bool:
+    """Install the CORS layer if this deployment is configured cross-origin.
+
+    Returns whether it was installed, so the caller can log which shape the
+    deployment is running in. An empty ``cors_allowed_origins`` means "same
+    origin" and installs nothing at all -- not a middleware that allows
+    nothing, which would still add ``Vary: Origin`` to every response and
+    imply a cross-origin setup that isn't there.
+    """
+    if not settings.cors_allowed_origins:
+        return False
+
+    app.add_middleware(
+        PortalScopedCORSMiddleware,
+        allow_origins=settings.cors_allowed_origins,
+    )
+    return True
+
+
+__all__ = [
+    "PORTAL_ADMIN_API_PREFIX",
+    "PORTAL_API_PREFIX",
+    "PortalScopedCORSMiddleware",
+    "install_portal_cors",
+    "is_cors_eligible_path",
+]
diff --git c/astrbot/portal/api/file_routes.py w/astrbot/portal/api/file_routes.py
new file mode 100644
index 00000000..242de337
--- /dev/null
+++ w/astrbot/portal/api/file_routes.py
@@ -0,0 +1,255 @@
+"""Attachment upload/download HTTP routes for the AstrBot Portal module
+(Phase 2).
+
+Every handler here goes through
+:mod:`astrbot.portal.services.attachment_service` -- the module that owns
+MIME/size/quota validation, the uniquified ``stored_filename`` generation,
+the ``PortalAttachmentOwner`` shadow-ownership bookkeeping, and the sole
+authorized wrapper around ``core_facade.save_upload``/``resolve_attachment``.
+This file must never import ``ChatService`` or any other capability-wall
+member directly (rule 5 of the module's engineering rules) -- it does not,
+and it does not need to: ``attachment_service`` already reaches
+``core_facade`` for the one core touchpoint (the actual disk write).
+
+These routes are the **sole sanctioned replacement** for core's own
+``GET /api/v1/files/*`` endpoints (``astrbot/dashboard/api/files.py``),
+which must never be exposed to the portal SPA -- those endpoints either
+have no ownership check at all (``/files/{attachment_id}``), resolve any
+file in the shared attachments directory by bare filename
+(``/files/content?filename=``), or have no auth dependency whatsoever
+(the token-based routes). See design/portal-multiuser-plan.md section 4,
+checklist item 4, and this phase's verified ground truth.
+
+Every ``user_id`` used below comes from
+:func:`astrbot.portal.auth.dependencies.get_current_user` -- never from a
+request body, query string, or header (rule 4).
+
+Ownership failures (``core_facade.ResourceNotFoundError``, raised by every
+``attachment_service`` function that takes a client-supplied
+``attachment_id``) map to HTTP 404, never 403 -- a 403 would let a caller
+distinguish "not yours" from "does not exist", i.e. an existence oracle
+(see ``PortalAttachmentOwner``'s class docstring in db/models.py and this
+phase's non-negotiable engineering rules).
+
+DELETE is deliberately NOT implemented here -- see the "Why no DELETE"
+section below for the concrete reason, rather than shipping a route that
+lies about what it does.
+
+Why no DELETE
+--------------
+A correct delete would need to do two things atomically: (1) remove the
+core ``Attachment`` row + on-disk file, and (2) give the byte quota back
+to the *exact* daily accounting window (``PortalUsageCounter.window_start``)
+it was originally charged against. ``PortalAttachmentOwner`` records
+``created_at`` but not which ``window_start`` the upload was charged
+under -- and ``_window_start()``'s truncation is a pure function of
+*when it runs*, not of any stored value, so re-deriving "the window this
+upload was charged to" from ``created_at`` after the fact is only reliable
+if the file is deleted within the same window it was uploaded in (true
+same-day deletes are fine; a delete of a file uploaded in an earlier
+window would silently credit *today's* counter instead of the row it was
+actually debited from -- a real accounting bug, not a cosmetic one).
+Additionally, ``core_facade.discard_orphaned_upload`` -- the only existing
+facade function that deletes a core attachment -- is explicitly documented
+as NOT owner-checked and NOT meant to be reachable from any client-supplied
+attachment_id ("Never call this with an attachment_id sourced from a
+client request"); wiring a client-facing DELETE route through it would
+mean either violating that documented contract or duplicating an
+independent, unaudited delete-from-core path here. Building this correctly
+needs a schema change (recording ``window_start`` on
+``PortalAttachmentOwner``, or a dedicated core-facade delete function that
+is explicitly designed to be owner-checked and client-reachable), which is
+outside this file's ownership (db/models.py, core_facade.py). Shipping a
+DELETE that silently mis-credits quota, or that reuses a function
+documented as unsafe for this exact purpose, would be worse than omitting
+it -- so it is omitted, and flagged here and in this phase's ``gaps``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from urllib.parse import quote
+
+from fastapi import APIRouter, Depends, File, HTTPException, Request, UploadFile
+from fastapi.responses import FileResponse
+
+from astrbot.portal.auth.dependencies import get_current_user, require_csrf
+from astrbot.portal.db.models import PortalUser
+from astrbot.portal.services import attachment_service
+from astrbot.portal.services.core_facade import ResourceNotFoundError
+
+router = APIRouter(prefix="/files", tags=["Portal Files"])
+"""Mounted by ``astrbot.portal.api.router.portal_router`` (prefix ``/portal``)
+exactly like ``chat_routes.router`` -- every path below ends up public at
+``/api/v1/portal/files/...``."""
+
+# MIME-type prefixes safe to render inline in a browser tab/`<img>`/`<audio>`/
+# `<video>` element without meaningfully increasing this endpoint's attack
+# surface, given `PortalSettings.allowed_upload_mime_types` already excludes
+# anything that executes as active content (no SVG, no HTML/JS, no
+# archives -- see that field's own docstring). Everything else (PDF, plain
+# text/CSV, JSON) is served as a forced download instead: none of those are
+# meant to be inline-previewed by the chat composer, and forcing a download
+# keeps one more browser code path (the built-in PDF/text viewer rendering
+# attacker-supplied bytes as a top-level "page" from this product's own
+# origin) out of the picture entirely.
+_INLINE_MIME_PREFIXES = ("image/", "audio/", "video/")
+
+
+def _content_disposition(display_filename: str, *, inline: bool) -> str:
+    """Build a ``Content-Disposition`` header value from a client-supplied
+    display filename, safely.
+
+    ``display_filename`` is ``PortalAttachmentOwner.original_filename`` --
+    attacker-controlled (it is whatever the uploading client sent) but
+    never used to resolve a path (see that field's own docstring); it is
+    used here purely as a header value, so it must be neutralized against
+    header-injection (stray CR/LF) and non-ASCII bytes that a bare
+    ``filename=`` parameter cannot carry safely. Both an ASCII-only
+    fallback (``filename=``) and an RFC 5987 percent-encoded UTF-8 form
+    (``filename*=``) are emitted, matching the standard dual-parameter
+    pattern browsers expect.
+    """
+    disposition = "inline" if inline else "attachment"
+    sanitized = display_filename.replace("\r", "").replace("\n", "").replace('"', "'")
+    ascii_fallback = sanitized.encode("ascii", "ignore").decode("ascii").strip()
+    if not ascii_fallback:
+        ascii_fallback = "download"
+    encoded = quote(sanitized, safe="")
+    return f'{disposition}; filename="{ascii_fallback}"; filename*=UTF-8\'\'{encoded}'
+
+
+# ---------------------------------------------------------------------------
+# Upload
+# ---------------------------------------------------------------------------
+
+
+@router.post("", status_code=201)
+async def upload_attachment(
+    request: Request,
+    file: UploadFile = File(...),
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    """Validate, quota-check, and persist one uploaded file.
+
+    Returns the ``attachment_id`` plus the display metadata the composer
+    needs to render an upload preview/pending-attachment chip -- deliberately
+    NOT ``attachment_service.upload_file``'s full result dict verbatim:
+    ``stored_filename`` (the on-disk uniquified name) is withheld, since it
+    is an internal implementation detail with no legitimate client use and
+    this route must never expose any filesystem-path-adjacent detail.
+
+    429 (with the caller's remaining daily quota in the body) on quota
+    exhaustion -- plan section 5, Phase 2 acceptance criterion 3 -- not a
+    silent drop/truncate. 415 for a disallowed MIME type, 400 for an
+    oversized or empty file.
+    """
+    try:
+        result = await attachment_service.upload_file(
+            current_user.user_id, request, file
+        )
+    except attachment_service.QuotaExceededError as exc:
+        raise HTTPException(
+            status_code=429,
+            detail={
+                "message": str(exc),
+                "remaining_quota_bytes": exc.remaining_bytes,
+            },
+        ) from exc
+    except attachment_service.UnsupportedMimeTypeError as exc:
+        raise HTTPException(status_code=415, detail=str(exc)) from exc
+    except attachment_service.FileTooLargeError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    except attachment_service.AttachmentServiceError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+
+    return {
+        "attachment_id": result["attachment_id"],
+        "filename": result["original_filename"],
+        "mime_type": result["mime_type"],
+        "attach_type": result["attach_type"],
+        "byte_size": result["byte_size"],
+        "remaining_quota_bytes": result["remaining_quota_bytes"],
+    }
+
+
+# ---------------------------------------------------------------------------
+# Download
+# ---------------------------------------------------------------------------
+
+
+@router.api_route("/{attachment_id}", methods=["GET", "HEAD"])
+async def download_attachment(
+    attachment_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+) -> FileResponse:
+    """Serve an attachment the caller owns.
+
+    ``HEAD`` has to be registered explicitly. FastAPI's ``@router.get``
+    registers ``methods=["GET"]`` and nothing else, so a ``HEAD`` request
+    against a GET-only route gets a flat ``405`` -- it does *not* fall back
+    to running the handler and dropping the body. The portal's file chip
+    probes with ``HEAD`` before offering a download
+    (``PortalAttachment.vue::probeFileExists``) and renders
+    "unavailable or deleted" on any non-OK response, so a GET-only
+    registration marks *every* file attachment broken in the UI. Starlette
+    still discards the body for us, so ``HEAD`` costs a stat, not a read.
+
+    Ownership is checked by ``attachment_service.download`` against
+    ``PortalAttachmentOwner`` BEFORE anything else happens; a missing row
+    or one owned by a different user both raise
+    ``core_facade.ResourceNotFoundError`` here, mapped to a single,
+    indistinguishable 404 -- never a 403 (that would confirm the id exists
+    but belongs to someone else, an existence oracle).
+
+    Security headers on the response, since this endpoint's entire job is
+    to serve attacker-supplied bytes from the product's own origin:
+
+    * ``X-Content-Type-Options: nosniff`` -- always set. Without it, a
+      browser could sniff a response's real bytes and render it as a
+      different type than the declared ``Content-Type`` (e.g. a
+      mis-declared upload sniffed as ``text/html``), reintroducing exactly
+      the risk the MIME allowlist (which excludes ``text/html``/SVG/JS) is
+      meant to close off.
+    * ``Content-Security-Policy: default-src 'none'; sandbox`` -- always
+      set. This only takes effect on the rare path where a browser
+      navigates to this URL directly as a top-level document/iframe (e.g.
+      a user opening the download link in a new tab) -- it is not enforced
+      for ordinary ``<img>``/``<audio>``/``<video>`` element loads, which
+      the portal composer's inline previews rely on and which are governed
+      by the *embedding* page's own CSP instead. ``sandbox`` with no
+      allow-* tokens disables script execution, forms, and top-level
+      navigation for that direct-navigation case -- the last line of
+      defense against a MIME-allowlist gap (e.g. the acknowledged one for
+      PDF: ``application/pdf`` is allowed but its internal-JavaScript risk
+      is not eliminated by this header, since a PDF viewer's own scripting
+      engine is not governed by the web page's CSP; closing that fully
+      would need a PDF-sanitizing parser, out of this phase's scope -- see
+      ``attachment_service.py``'s module docstring for the equivalent,
+      already-stated MIME-verification gap).
+    * ``Content-Disposition``: ``inline`` for image/audio/video (so the
+      composer's `<img>`/`<audio>`/`<video>` previews work), forced
+      ``attachment`` for everything else (PDF/text/CSV/JSON) -- these are
+      not meant to be inline-previewed by the composer, and forcing a
+      download keeps the browser's own PDF/text viewer from ever rendering
+      attacker-supplied bytes as a navigated-to page from this origin.
+    """
+    try:
+        path, mime_type, display_filename = await attachment_service.download(
+            current_user.user_id, request, attachment_id
+        )
+    except ResourceNotFoundError as exc:
+        raise HTTPException(status_code=404, detail="Not found") from exc
+
+    inline = mime_type.startswith(_INLINE_MIME_PREFIXES)
+    headers = {
+        "X-Content-Type-Options": "nosniff",
+        "Content-Security-Policy": "default-src 'none'; sandbox",
+        "Content-Disposition": _content_disposition(display_filename, inline=inline),
+    }
+    return FileResponse(path, media_type=mime_type, headers=headers)
+
+
+__all__ = ["router"]
diff --git c/astrbot/portal/api/kb_routes.py w/astrbot/portal/api/kb_routes.py
new file mode 100644
index 00000000..5faead24
--- /dev/null
+++ w/astrbot/portal/api/kb_routes.py
@@ -0,0 +1,236 @@
+"""End-user knowledge-base visibility + session-binding HTTP routes for the
+AstrBot Portal module (Phase 3).
+
+Every handler here goes through :mod:`astrbot.portal.services.
+kb_visibility_service` (the admin-curated whitelist + count/top_k
+validation layer) and, for the read-back route, directly through
+:mod:`astrbot.portal.services.core_facade` (the capability wall). This file
+must never import ``kb_mgr``/``core_lifecycle``/``ChatService`` or any other
+capability-wall member directly (rule 5 of the module's engineering rules);
+it does not need to -- both services already reach the one core touchpoint
+they need on this route's behalf.
+
+Every ``user_id`` used below comes from
+:func:`astrbot.portal.auth.dependencies.get_current_user` -- never from a
+request body, query string, or header (rule 4).
+
+403 vs 404 (engineering rule 8) -- DECISION: 404, always
+-----------------------------------------------------------------------
+The plan's Phase 3 acceptance criterion 1 states that binding a
+non-whitelisted ``kb_id`` should return 403. This file deliberately does
+**not** follow that literal wording, and instead maps every authorization/
+existence failure raised by ``kb_visibility_service``/``core_facade`` --
+"never whitelisted", "whitelisted but revoked", "whitelisted but the KB was
+since deleted from core", and "session not owned by this caller" alike --
+to a single, indistinguishable HTTP 404. Reasons, in order of weight:
+
+1. **Consistency with the rest of this module.** Every other portal route
+   (``chat_routes.py``, ``file_routes.py``) already maps
+   ``core_facade.ResourceNotFoundError`` to 404, specifically so a response
+   can never be used as an existence oracle (module docstring invariant 2
+   in ``core_facade.py``). Making the KB bind path the one 403 exception
+   would reintroduce exactly the asymmetry the rest of the module goes out
+   of its way to avoid, for no consistent security benefit.
+2. **``kb_visibility_service.py`` already made this call.** Its module
+   docstring (see that file) explains at length why it raises the exact
+   same ``core_facade.ResourceNotFoundError`` class for every KB
+   authorization failure, not a distinct "Forbidden" type. This route file
+   has no separate exception to map to 403 even if it wanted to -- doing so
+   would mean adding a parallel, redundant classification step here whose
+   only purpose would be to contradict the service layer's own documented
+   reasoning.
+3. **KBs are not the caller's own resource.** Unlike a session or an
+   attachment (owned by the caller, so "yours vs. someone else's" is a
+   meaningful distinction a 403 could honestly represent), a knowledge base
+   is a global operator resource the caller has never owned in the first
+   place. A 403 here could only ever mean "exists in core but not on your
+   whitelist" -- letting a caller enumerate the operator's non-whitelisted
+   KB inventory one guess at a time by bind-probing kb_ids, which is
+   exactly the whitelist's own job to prevent (see
+   ``kb_visibility_service.list_visible``'s "never leak the operator's
+   full KB inventory" contract).
+
+Tests written against these routes must assert 404, not 403, for every
+authorization-failure case.
+
+Unbind = bind with an empty list (no separate DELETE route)
+-----------------------------------------------------------------------
+There is exactly one write route, ``POST .../sessions/{id}/knowledge-base``,
+and it accepts an empty ``kb_ids`` list as a completely ordinary, valid
+request: ``kb_visibility_service.bind_session`` skips both the whitelist
+and live-existence checks when the deduplicated id list is empty and simply
+writes ``{"kb_ids": [], "top_k": ...}`` via ``core_facade.
+set_session_kb_config`` -- the exact same explicit "no knowledge base"
+shape the default-open-trap fix (``core_facade.py`` invariant 4) already
+writes at session creation. A dedicated ``DELETE`` route would do nothing
+this one request shape doesn't already do correctly, and would double the
+number of places a client-triggered write into ``kb_config`` could happen
+from. Chosen for consistency and to keep exactly one audited write path
+into a session's KB binding, mirroring ``core_facade.set_session_kb_config``'s
+own single-writer design.
+"""
+
+from __future__ import annotations
+
+from typing import Any, NoReturn
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from pydantic import BaseModel, ConfigDict, Field
+
+from astrbot.portal.auth.dependencies import get_current_user, require_csrf
+from astrbot.portal.db.models import PortalUser
+from astrbot.portal.services import core_facade, kb_visibility_service
+from astrbot.portal.services.core_facade import CoreFacadeError, ResourceNotFoundError
+from astrbot.portal.services.kb_visibility_service import (
+    InvalidTopKError,
+    KbSelectionDisabledError,
+    KbVisibilityServiceError,
+    TooManyKbIdsError,
+)
+
+router = APIRouter(tags=["Portal Knowledge Bases"])
+"""No sub-prefix of its own (unlike ``chat_routes.router``'s ``/chat``):
+mounted directly by ``astrbot.portal.api.router.portal_router`` (prefix
+``/portal``), so the two routes below end up public at exactly
+``/api/v1/portal/knowledge-bases`` and
+``/api/v1/portal/sessions/{session_id}/knowledge-base`` -- matching this
+assignment's endpoint list verbatim. Declaring a ``/sessions/...`` path
+here alongside ``chat_routes.py``'s own ``/chat/sessions/...`` paths is
+not a collision: the two routers are mounted at different sub-trees
+(no prefix here vs ``/chat`` there), so the full paths never overlap."""
+
+
+# ---------------------------------------------------------------------------
+# Request models. extra="ignore" so stray client fields are silently
+# dropped, matching every other request model in this module (chat_routes.py).
+# ---------------------------------------------------------------------------
+
+
+class BindKnowledgeBaseRequest(BaseModel):
+    """Body for ``POST /sessions/{session_id}/knowledge-base``.
+
+    ``kb_ids`` may legitimately be empty (see module docstring: this is how
+    a session is unbound). The upper bound of 100 here is a generous,
+    purely defensive sanity cap against an absurdly large payload -- the
+    real, authoritative limit is
+    ``PortalSettings.max_kb_ids_per_session`` (default 3), enforced by
+    ``kb_visibility_service.bind_session`` and reported as
+    :class:`~astrbot.portal.services.kb_visibility_service.TooManyKbIdsError`
+    (-> HTTP 400) below, not by this model.
+    """
+
+    model_config = ConfigDict(extra="ignore")
+
+    kb_ids: list[str] = Field(default_factory=list, max_length=100)
+    top_k: int | None = None
+
+
+# ---------------------------------------------------------------------------
+# Error translation. See module docstring's "403 vs 404" section: every
+# authorization/existence failure maps to 404, never 403.
+# ---------------------------------------------------------------------------
+
+
+def _raise_for_kb_error(exc: Exception) -> NoReturn:
+    if isinstance(exc, ResourceNotFoundError):
+        raise HTTPException(status_code=404, detail=str(exc) or "Not found") from exc
+    if isinstance(exc, KbSelectionDisabledError):
+        # A blanket operator feature-switch, not a per-resource
+        # authorization decision -- see kb_visibility_service.py's own
+        # docstring on this exception for why 403 (not 404) is fine here:
+        # there is no existence to hide behind a whitelist-of-one switch.
+        raise HTTPException(status_code=403, detail=str(exc)) from exc
+    if isinstance(exc, (TooManyKbIdsError, InvalidTopKError)):
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    if isinstance(exc, KbVisibilityServiceError):
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    raise HTTPException(status_code=400, detail=str(exc)) from exc
+
+
+# ---------------------------------------------------------------------------
+# Routes
+# ---------------------------------------------------------------------------
+
+
+@router.get("/knowledge-bases")
+async def list_knowledge_bases(
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+) -> dict[str, Any]:
+    """The enabled whitelist entries this user may choose from.
+
+    Thin pass-through to ``kb_visibility_service.list_visible``, which
+    already guarantees: only ``enabled=True`` whitelist rows are even
+    considered, any row whose ``kb_id`` no longer exists in core is
+    silently dropped (never shown as broken-but-visible), and the shape
+    returned per entry is the narrow, consumer-facing one (``kb_id``,
+    ``display_name``, ``description``, doc/chunk counts, ``available``) --
+    never the operator's raw ``kb_name`` cache, ``granted_by``, or any
+    KB outside the whitelist. This route performs no shaping of its own
+    beyond wrapping the list in an object.
+    """
+    entries = await kb_visibility_service.list_visible(current_user.user_id, request)
+    return {"knowledge_bases": entries}
+
+
+@router.get("/sessions/{session_id}/knowledge-base")
+async def get_session_knowledge_base(
+    session_id: str,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+) -> dict[str, Any]:
+    """The current ``kb_config`` binding for a session owned by this user.
+
+    Ownership is checked by ``core_facade.get_session_kb_config`` (via its
+    internal ``_owned_session_row`` gate) before anything else happens; a
+    missing session or one owned by someone else both raise
+    ``core_facade.ResourceNotFoundError`` here, mapped to 404 (see module
+    docstring's "403 vs 404" section). Always returns a well-shaped
+    ``{"kb_ids": [...], "top_k": ...}`` -- never ``None`` -- since the
+    facade backfills an explicit empty binding for any session that
+    predates Phase 3 (the default-open-trap fix, ``core_facade.py``
+    invariant 4).
+    """
+    try:
+        return await core_facade.get_session_kb_config(
+            current_user.user_id, request, session_id
+        )
+    except CoreFacadeError as exc:
+        _raise_for_kb_error(exc)
+
+
+@router.post("/sessions/{session_id}/knowledge-base")
+async def bind_session_knowledge_base(
+    session_id: str,
+    payload: BindKnowledgeBaseRequest,
+    request: Request,
+    current_user: PortalUser = Depends(get_current_user),
+    _csrf: None = Depends(require_csrf),
+) -> dict[str, Any]:
+    """Bind (or, with an empty ``kb_ids``, unbind -- see module docstring)
+    a set of knowledge bases to a session owned by this user.
+
+    All validation happens in ``kb_visibility_service.bind_session`` before
+    anything is written: the feature master switch, the
+    ``max_kb_ids_per_session`` count cap, ``top_k`` range validation
+    (rejected outright when out of range, never silently clamped -- see
+    that function's own docstring), and -- critically -- that EVERY
+    requested id is both an enabled portal whitelist entry AND still
+    exists in core right now. Any single id failing either check rejects
+    the WHOLE request; this route never binds a partial subset of what was
+    requested. See module docstring's "403 vs 404" section for why every
+    one of those authorization/existence failures surfaces as 404.
+    """
+    try:
+        return await kb_visibility_service.bind_session(
+            current_user.user_id,
+            request,
+            session_id,
+            payload.kb_ids,
+            payload.top_k,
+        )
+    except (CoreFacadeError, KbVisibilityServiceError) as exc:
+        _raise_for_kb_error(exc)
+
+
+__all__ = ["router"]
diff --git c/astrbot/portal/api/router.py w/astrbot/portal/api/router.py
new file mode 100644
index 00000000..e95fb631
--- /dev/null
+++ w/astrbot/portal/api/router.py
@@ -0,0 +1,66 @@
+"""Aggregate router for the AstrBot Portal module's HTTP API surface.
+
+Exports a single ``portal_router`` (prefix ``/portal``) that
+``astrbot.dashboard.api.router.build_api_router`` mounts with one line
+(``router.include_router(portal_router)``). ``build_api_router`` already
+applies the ``/api/v1`` prefix on top, so every route declared here ends up
+public at ``/api/v1/portal/*`` -- e.g. ``/portal/auth/login`` (declared in
+``auth_routes.py`` under its own ``/portal/auth`` sub-prefix) becomes
+``/api/v1/portal/auth/login``.
+
+This is the *API* router, and it is all AstrBot serves for the portal. The
+end-user SPA is a separate project with its own deployment
+(https://github.com/AstrBotDevs/astrbot-portal); nothing here serves static
+assets. See ``PortalSettings.cors_allowed_origins`` for the cross-origin case.
+
+``chat_routes.py`` and ``file_routes.py`` are each owned by a different,
+concurrently-developed assignment in this same phase; they are imported
+here purely by module path (``astrbot.portal.api.chat_routes`` /
+``astrbot.portal.api.file_routes``) and are each expected to export a
+plain ``router: APIRouter`` symbol, exactly like every other router in
+this package. ``file_routes.py`` (Phase 2) is the sole sanctioned
+replacement for core's own ``/api/v1/files/*`` endpoints, which must never
+be exposed to the portal SPA (see design/portal-multiuser-plan.md section
+4, checklist item 4).
+
+``kb_routes.py`` (Phase 3, end-user KB visibility + session binding,
+``Depends(get_current_user)``) and ``admin_routes.py`` (Phase 3 KB-visibility
+CRUD, Phase 4 agent-bundle CRUD -- both ``Depends(require_system_scope)``
+imported verbatim from ``astrbot.dashboard.api.auth``) are mounted the same
+way. See ``admin_routes.py``'s own module docstring for an explicit,
+loudly-flagged deployment-checklist gap: mounting an operator-only router
+here means its paths inherit the ``/api/v1/portal/*`` prefix design/portal-
+multiuser-plan.md section 4 checklist item 6 currently tells operators to
+open to the public internet, so that checklist's reverse-proxy rule must be
+amended to carve out ``/api/v1/portal/admin/*`` as an internal/VPN-only
+exception -- this file has no other mount point available to it (the
+dashboard's own ``build_api_router`` includes only this single
+``portal_router``, and is not owned by this assignment).
+
+``agent_routes.py`` (Phase 4, end-user Agent Bundle selection --
+``Depends(get_current_user)``) is mounted the same way as ``kb_routes.py``:
+no sub-prefix of its own, so its routes end up public at
+``/api/v1/portal/agent-bundles`` and
+``/api/v1/portal/sessions/{session_id}/agent-bundle``.
+"""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from astrbot.portal.api.admin_routes import router as admin_router
+from astrbot.portal.api.agent_routes import router as agent_router
+from astrbot.portal.api.auth_routes import router as auth_router
+from astrbot.portal.api.chat_routes import router as chat_router
+from astrbot.portal.api.file_routes import router as file_router
+from astrbot.portal.api.kb_routes import router as kb_router
+
+portal_router = APIRouter(prefix="/portal", tags=["Portal"])
+portal_router.include_router(auth_router)
+portal_router.include_router(chat_router)
+portal_router.include_router(file_router)
+portal_router.include_router(kb_router)
+portal_router.include_router(agent_router)
+portal_router.include_router(admin_router)
+
+__all__ = ["portal_router"]
