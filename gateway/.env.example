# AstrBot address as seen from the gateway (keep AstrBot on an internal network)
ASTRBOT_BASE_URL=http://astrbot:6185
# AstrBot WebUI -> Settings -> API Keys, scopes: chat, file
ASTRBOT_API_KEY=

# HS256 secret shared with your login system (at least 32 bytes)
GATEWAY_JWT_SECRET=
# Optional: required `aud` / `iss` claims
GATEWAY_JWT_AUDIENCE=
GATEWAY_JWT_ISSUER=

# Plans: config_id = AstrBot config profile ID (null = default routing),
# daily_chat_limit = null for unlimited
GATEWAY_PLANS={"free": {"config_id": null, "daily_chat_limit": 50, "storage_mb": 100}, "pro": {"config_id": null, "daily_chat_limit": null, "storage_mb": 2048}}
GATEWAY_DEFAULT_PLAN=free

GATEWAY_DATA_DIR=/data
GATEWAY_MAX_FILE_MB=20
GATEWAY_MAX_DOC_CHARS=100000
# 0 keeps files forever
GATEWAY_FILE_TTL_DAYS=30

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=INFO
